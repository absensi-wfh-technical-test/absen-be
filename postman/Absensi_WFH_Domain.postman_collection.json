          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Absensi dihapus pemilik\", function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Status hari ini setelah hapus",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/attendances/me/today",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status kembali kosong\", function () { pm.response.to.have.status(200); const body = pm.response.text(); pm.expect(body === '' ? null : JSON.parse(body)).to.eql(null); });"
                ]
