    },
    {
      "key": "proofPrivateKey",
      "value": ""
    },
    {
      "key": "proofPublicKey",
      "value": ""
    },
    {
      "key": "checkInPhotoSha256",
      "value": "dUYWCtR0dJ8VX9fwUzi0Uyu_fM_ZDalIBmiX090cOtY"
    },
    {
      "key": "replacementPhotoSha256",
      "value": "TDZjFr5rgSCuX67uYqjx3SJTqgaB64ejkONfEqr2dhA"
    },
    {
      "key": "testEmployeeCode",
      "value": ""
    },
    {
      "key": "testEmployeeEmail",
      "value": ""
    },
    {
      "key": "testEmployeePassword",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "attendanceId",
      "value": ""
    },
    {
      "key": "originalCheckInAt",
      "value": ""
    },
    {
      "key": "departmentId",
      "value": ""
    },
    {
      "key": "positionId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Postman test client only. The exported private JWK lives in local collection",
          "// variables so multiple requests can demonstrate one session; clear it after use.",
          "function toBase64Url(bytes) {",
          "  let binary = ''",
          "  for (const byte of bytes) binary += String.fromCharCode(byte)",
          "  return btoa(binary).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '')",
          "}",
          "",
          "let privateKey",
          "let publicHeader = pm.collectionVariables.get('proofPublicKey')",
          "const savedPrivate = pm.collectionVariables.get('proofPrivateKey')",
          "if (savedPrivate && publicHeader) {",
          "  privateKey = await crypto.subtle.importKey('jwk', JSON.parse(savedPrivate),",
          "    { name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign'])",
          "} else {",
          "  const pair = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign', 'verify'])",
          "  privateKey = pair.privateKey",
          "  const privateJwk = await crypto.subtle.exportKey('jwk', pair.privateKey)",
          "  const publicJwk = await crypto.subtle.exportKey('jwk', pair.publicKey)",
          "  publicHeader = toBase64Url(new TextEncoder().encode(JSON.stringify(publicJwk)))",
          "  pm.collectionVariables.set('proofPrivateKey', JSON.stringify(privateJwk))",
          "  pm.collectionVariables.set('proofPublicKey', publicHeader)",
          "}",
          "",
          "const url = new URL(pm.variables.replaceIn(pm.request.url.toString()))",
          "const target = url.pathname + url.search",
          "const method = pm.request.method.toUpperCase()",
          "const isPhoto = pm.request.body?.mode === 'formdata'",
          "const body = pm.request.body?.mode === 'raw' ? pm.variables.replaceIn(pm.request.body.raw ?? '') : ''",
          "const timestamp = Date.now().toString()",
          "const nonce = crypto.randomUUID()",
          "const photoHashKey = method === 'PATCH' ? 'replacementPhotoSha256' : 'checkInPhotoSha256'",
          "const digest = isPhoto ? pm.collectionVariables.get(photoHashKey) : toBase64Url(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(body))))",
          "if (isPhoto && !/^[A-Za-z0-9_-]{43}$/.test(digest ?? '')) throw new Error(`Isi ${photoHashKey} dengan SHA-256 base64url dari file yang dipilih`)",
          "const version = isPhoto ? 'v2' : 'v1'",
          "const base = `${version}\\n${method}\\n${target}\\n${timestamp}\\n${nonce}\\n${digest}`",
          "const signature = new Uint8Array(await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, privateKey,",
          "  new TextEncoder().encode(base)))",
          "",
          "pm.request.headers.upsert({ key: 'X-Request-Timestamp', value: timestamp })",
          "pm.request.headers.upsert({ key: 'X-Request-Nonce', value: nonce })",
          "pm.request.headers.upsert({ key: 'X-Request-Key', value: publicHeader })",
          "pm.request.headers.upsert({ key: 'X-Request-Signature', value: toBase64Url(signature) })"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Kesiapan",
      "item": [
        {
          "name": "Health database",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/database"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Database terhubung\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.deep.include({ status: 'ok', database: 'connected' }); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Login HRD",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = crypto.randomUUID().replace(/-/g, '').slice(0, 12);",
                  "pm.collectionVariables.set('testEmployeeCode', `PM${runId.toUpperCase()}`);",
                  "pm.collectionVariables.set('testEmployeeEmail', `pm-${runId}@example.test`);",
                  "pm.collectionVariables.set('testEmployeePassword', `Pm-${runId}-Pass1!`);",
                  "for (const key of ['adminToken', 'employeeToken', 'employeeId', 'attendanceId', 'originalCheckInAt']) pm.collectionVariables.unset(key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ADMIN login dan JWT\", function () { pm.response.to.have.status(200); const data = pm.response.json(); pm.expect(data.user.roleCode).to.eql('ADMIN'); pm.expect(data.accessToken).to.be.a('string').and.not.empty; pm.expect(data.user).to.not.have.property('passwordHash'); pm.collectionVariables.set('adminToken', data.accessToken); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Me ADMIN",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Identitas ADMIN\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().roleCode).to.eql('ADMIN'); });"
                ]
              }
            }
          ]
        }
      ]
    },
