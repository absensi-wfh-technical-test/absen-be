            "url": "{{baseUrl}}/api/attendances/{{attendanceId}}/photo",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Foto dapat dibaca HRD\", function () { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "HRD tidak boleh ganti foto",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/attendances/{{attendanceId}}/photo",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403 FORBIDDEN\", function () { pm.response.to.have.status(403); pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'); });"
                ]
              }
            }
          ]
        },
